{
  "name": "craboodle",
  "version": "0.1.0",
  "description": "Eval pipeline orchestrator for Claude Code",
  "keywords": [
    "claude",
    "anthropic",
    "claude-code",
    "agent-sdk",
    "cli",
    "llm",
    "ai",
    "eval",
    "evaluation",
    "orchestrator",
    "pipeline"
  ],
  "author": "Benjamin Kudria <ben@kudria.net>",
  "license": "MIT",
  "homepage": "https://github.com/bkudria/craboodle#readme",
  "bugs": {
    "url": "https://github.com/bkudria/craboodle/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bkudria/craboodle.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "craboodle": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc && chmod +x dist/cli.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "dev": "tsx src/cli.ts",
    "prepare": "husky",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "glob": "^13.0.6",
    "p-limit": "^7.3.0",
    "word-wrap": "^1.2.5",
    "yaml": "^2.8.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.1",
    "husky": "^9.1.7",
    "prettier": "3.8.3",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  }
}
