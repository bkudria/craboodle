-- allium: 3
-- craboodle.allium
--
-- Scope: Craboodle eval pipeline orchestrator for Claude Code configurations.
-- Includes:
--   - The run, list, lint and init CLI commands
--   - Scenario discovery, repetition averaging, streaming YAML output
--   - Ratchet and budget gates (mid-run fail-fast)
--   - Artifact directory lifecycle and garbage collection
--   - evals.yaml load-time validation
--   - Staged filtered view of the eval root (one tempdir per invocation)
-- Excludes:
--   - Scuttlerun session behaviour (external; modelled as a contract)
--   - Pincenez grading and lint logic (external; modelled as contracts)
--   - YAML serialisation mechanics and CLI argument parsing
--   - TypeScript / Node runtime details (subprocess plumbing, async scheduling)
--
-- Exit code taxonomy (shared with scuttlerun and pincenez):
--   0    pipeline completed (some rep succeeded; ratchet not violated)
--   1    configuration / input error, or lint found issues
--   2    uncaught runtime exception (incl. evals.yaml load failure)
--   3    ratchet failure (any scenario below min_pass_rate)
--   4    infrastructure / dependency error
--          (no scenarios, empty filter, zero successful reps across all
--          scenarios, zero lint invocations succeeded, or a gated scenario's
--          error_rate exceeds max_error_rate)
--   5    budget exhausted (max_budget_usd reached; mirrors scuttlerun's
--          exhausted_budget so CI can distinguish budget cutoff from
--          generic failure)
--   6-7  reserved for scuttlerun-only concerns (timed_out, exhausted_turns)
--   130  interrupted (SIGINT)

config {
    default_repeats: Integer = 3
    default_concurrency: Integer = 10
    default_scenarios_path: String = "evals"
    artifact_retention_days: Integer = 7   -- 0 disables cleanup
    artifact_prefix: String = "craboodle-run-"
    staged_view_prefix: String = "craboodle-staged-"
    supported_config_versions: Set<String> = {"1"}
}

-- ============================================================================
-- External entities (artifacts that flow across the scuttlerun / pincenez
-- boundary; craboodle treats their contents as opaque)
-- ============================================================================

external entity ScuttlerunConfig {
    path: String
}

external entity ChecksConfig {
    path: String
    check_count: Integer
}

external entity Transcript {
    path: String
    cost_usd: Decimal?
}

external entity Grading {
    path: String
    checks: List<GradedCheck>
    cost_usd: Decimal?
}

-- ============================================================================
-- Value types
-- ============================================================================

value GradedCheck {
    id: String
    check: String
    pass: Boolean?
    evidence: String
}

value LintedCheck {
    id: String
    check: String
    issues: List<LintIssue>
}

value LintIssue {
    anti_pattern: String
    suggestion: String
}

-- The resolved (post-merge) session summary scuttlerun prints on a
-- successful dry_run. craboodle consumes only these two fields; the rest
-- of the summary is opaque.
value ResolvedSessionConfig {
    tools: List<String>?
    prompt: String?
}

value RepFailureEvidence {
    rep: Integer
    evidence: String
    transcript_path: String?
}

value RepError {
    rep: Integer
    stage: scuttlerun | pincenez | fail_fast | budget
    error: String
    exit_code: Integer?
    transcript: String?
}

-- ============================================================================
-- Actor
-- ============================================================================

actor Operator {
    -- The human or CI process invoking the craboodle CLI.
    identified_by: invocation_id
}

-- ============================================================================
-- Inputs
-- ============================================================================

-- The directory containing evals.yaml. The same directory typically also
-- contains SKILL.md (skill mode) or .claude-plugin/plugin.json (plugin mode);
-- mode = generic when neither marker is present and skill paths in
-- scenarios.base.project.skills must be absolute or ~-prefixed. In plugin
-- mode, the manifest contents (plugin.json) are parsed and the plugin's
-- component layout is enumerated by filesystem convention.
entity EvalRoot {
    path: String
    mode: skill | plugin | generic
    evals_config: EvalsConfig with eval_root = this
    scenarios: Set<Scenario> with eval_root = this
    plugin_manifest: PluginManifest? with eval_root = this
    plugin_components: PluginComponents? with eval_root = this
}

entity Scenario {
    eval_root: EvalRoot
    id: String
    scenario_config: ScuttlerunConfig
    checks_config: ChecksConfig
}

-- The parsed evals.yaml file at <eval_root>/evals.yaml. The top-level
-- pipeline knobs (min_pass_rate, max_error_rate, max_budget_usd, repeats,
-- retention) sit alongside scenarios.base, which is an opaque scuttlerun
-- config block applied to every scenario.
entity EvalsConfig {
    eval_root: EvalRoot
    version: String
    min_pass_rate: Decimal?
    max_error_rate: Decimal?                -- reliability tolerance; active only with min_pass_rate
    max_budget_usd: Decimal?
    repeats_override: Integer?
    artifact_retention_days_override: Integer?
    timeout_override: Integer?              -- per-scenario scuttlerun session timeout (seconds)
    scenarios_path: String                  -- defaults to config.default_scenarios_path
    scenarios_base: ScuttlerunConfig        -- opaque to craboodle; passed to scuttlerun
}

-- The parsed .claude-plugin/plugin.json manifest, present only when
-- eval_root.mode = plugin. Only the metadata documented by the upstream
-- Claude Code plugin schema is modelled here; unknown fields are
-- preserved through the manifest reader for forward compatibility but
-- are not promoted to entity attributes.
entity PluginManifest {
    eval_root: EvalRoot
    name: String
    description: String?
    version: String?
    license: String?
    repository: String?
    homepage: String?
    keywords: List<String>?
    author: String?
}

-- The plugin's component layout, enumerated by filesystem convention
-- under eval_root.path. plugin.json itself does not declare components;
-- they are discovered by scanning skills/<id>/SKILL.md, agents/<id>.md,
-- commands/<id>.md, hooks/hooks.json, and the root-level .mcp.json.
-- Present only when eval_root.mode = plugin.
entity PluginComponents {
    eval_root: EvalRoot
    skills: List<String>                    -- sorted ids of skills/<id>/SKILL.md
    agents: List<String>                    -- sorted ids of agents/<id>.md
    commands: List<String>                  -- sorted ids of commands/<id>.md
    has_hooks: Boolean                      -- true iff hooks/hooks.json present
    has_mcp_servers: Boolean                -- true iff .mcp.json present at plugin root
}

-- A per-invocation tempdir that mirrors eval_root, symlinking every child
-- except scenarios_path. scenarios.base is materialised into the staged
-- view as .craboodle-base.yaml so scuttlerun can be invoked with a pair of
-- file paths (its existing two-config-file API). The basename of the
-- staged root is preserved from eval_root so self-referential
-- project.skills: [.] resolves cleanly. Staged views are GC'd by the same
-- retention window as artifact_dir.
entity StagedView {
    path: String                            -- <tmpdir>/<staged_view_prefix>X/<basename(eval_root.path)>
    base_config_path: String                -- <path>/.craboodle-base.yaml
    excluded_path: String                   -- = eval_root.evals_config.scenarios_path
}

-- ============================================================================
-- Invocations (one entity per CLI command, each with its own lifecycle)
-- ============================================================================

entity RunInvocation {
    operator: Operator
    eval_root: EvalRoot
    repeats: Integer
    concurrency: Integer
    timeout: Integer?                       -- null = let scuttlerun apply its own default
    scenario_filter: String?
    agent_model_override: String?
    grader_model_override: String?

    status: starting | discovering | streaming | completed | failed
    exit_code: Integer when status = completed | failed
    artifact_dir: String when status = streaming | completed
    staged_view: StagedView? with invocation = this

    work_items: Set<WorkItem> with invocation = this
    scenario_results: Set<ScenarioResult> with invocation = this

    -- Projections
    selected_scenarios:
        if scenario_filter != null:
            eval_root.scenarios where matches_pattern(id, scenario_filter)
        else:
            eval_root.scenarios

    queued_items: work_items where status = queued
    successful_items: work_items where status = succeeded
    items_with_transcript: work_items where transcript_path != null

    -- Derived
    has_any_success: successful_items.count > 0
    all_scenarios_done: scenario_results.count = selected_scenarios.count

    cumulative_cost_usd:
        sum_decimals(items_with_transcript.agent_cost_usd)
        + sum_decimals(successful_items.grading_cost_usd)

    total_cost_usd: sum_decimals(scenario_results.cost_usd)

    budget_exceeded:
        eval_root.evals_config.max_budget_usd != null
        and cumulative_cost_usd > eval_root.evals_config.max_budget_usd

    fail_fast_triggered:
        eval_root.evals_config.min_pass_rate != null
        and scenario_results.any(s =>
            s.pass_rate = null
            or s.pass_rate < eval_root.evals_config.min_pass_rate)

    error_gate_triggered:
        eval_root.evals_config.min_pass_rate != null
        and scenario_results.any(s =>
            (eval_root.evals_config.max_error_rate = null and s.error_rate > 0)
            or (eval_root.evals_config.max_error_rate != null
                and s.error_rate > eval_root.evals_config.max_error_rate))

    interrupt_requested: Boolean = false

    transitions status {
        starting -> discovering
        discovering -> streaming
        discovering -> failed
        streaming -> completed
        terminal: completed, failed
    }
}

entity ListInvocation {
    operator: Operator
    eval_root: EvalRoot
    scenario_filter: String?

    status: starting | discovering | streaming | completed | failed
    exit_code: Integer when status = completed | failed
    staged_view: StagedView? with invocation = this

    list_entries: Set<ListEntry> with invocation = this
    invalid_entries: list_entries where not valid

    selected_scenarios:
        if scenario_filter != null:
            eval_root.scenarios where matches_pattern(id, scenario_filter)
        else:
            eval_root.scenarios

    all_entries_done: list_entries.count = selected_scenarios.count
    any_invalid: list_entries.any(e => not e.valid)

    total_scenarios: list_entries.count
    total_checks: sum_integers(list_entries.check_count)
    invalid_count: invalid_entries.count

    transitions status {
        starting -> discovering
        discovering -> streaming
        discovering -> failed
        streaming -> completed
        terminal: completed, failed
    }
}

entity LintInvocation {
    operator: Operator
    eval_root: EvalRoot
    scenario_filter: String?
    concurrency: Integer
    grader_model_override: String?

    status: starting | discovering | streaming | completed | failed
    exit_code: Integer when status = completed | failed
    staged_view: StagedView? with invocation = this

    lint_results: Set<LintScenarioResult> with invocation = this
    results_with_issues: lint_results where checks_with_issues > 0

    selected_scenarios:
        if scenario_filter != null:
            eval_root.scenarios where matches_pattern(id, scenario_filter)
        else:
            eval_root.scenarios

    all_lint_invocations_done: lint_results.count = selected_scenarios.count
    total_issues: sum_integers(lint_results.checks_with_issues)

    scenarios_total: lint_results.count
    scenarios_with_issues: results_with_issues.count
    checks_total: sum_integers(lint_results.checks_total)
    checks_with_issues: total_issues

    transitions status {
        starting -> discovering
        discovering -> streaming
        discovering -> failed
        streaming -> completed
        terminal: completed, failed
    }
}

entity InitInvocation {
    operator: Operator
    target_dir: String

    status: starting | refused | created
    refusal_reason: existing_evals_yaml | existing_scenario_files
        when status = refused
    exit_code: Integer when status = refused | created

    transitions status {
        starting -> refused
        starting -> created
        terminal: refused, created
    }
}

-- ============================================================================
-- Run-pipeline entities
-- ============================================================================

-- A single (scenario, rep) pair. The pool slot is held across the scuttlerun
-- and pincenez stages; a rep can fail at either stage.
entity WorkItem {
    invocation: RunInvocation
    scenario: Scenario
    rep_number: Integer

    status: queued | running | succeeded | failed | aborted | budget_skipped | interrupted

    transcript_path: String? when status = succeeded | failed
    agent_cost_usd: Decimal? when status = succeeded | failed
    grading_cost_usd: Decimal? when status = succeeded
    grading: List<GradedCheck> when status = succeeded
    failure_stage: scuttlerun | pincenez when status = failed
    failure_message: String when status = failed | aborted | budget_skipped | interrupted

    is_terminal: status in {succeeded, failed, aborted, budget_skipped, interrupted}

    transitions status {
        queued -> running
        queued -> aborted
        queued -> budget_skipped
        queued -> interrupted
        running -> succeeded
        running -> failed
        running -> interrupted
        terminal: succeeded, failed, aborted, budget_skipped, interrupted
    }
}

-- Aggregated per-scenario result, produced once every WorkItem for the
-- scenario has reached a terminal state.
entity ScenarioResult {
    invocation: RunInvocation
    scenario: Scenario

    successful_reps_count: Integer
    failed_reps_count: Integer

    checks: List<CheckAggregate> with scenario_result = this
    pass_rate: Decimal?              -- null iff successful_reps_count = 0
    error_rate: Decimal              -- crashed reps / reps that ran (0 if none ran)
    agent_cost_usd: Decimal
    grading_cost_usd: Decimal
    cost_usd: Decimal                -- agent + grading
    errors: List<RepError>
}

entity CheckAggregate {
    scenario_result: ScenarioResult
    id: String
    check: String
    pass_rate: Decimal
    failures: List<RepFailureEvidence> when pass_rate < 1.0
}

-- ============================================================================
-- List-pipeline entity
-- ============================================================================

entity ListEntry {
    invocation: ListInvocation
    scenario: Scenario
    check_count: Integer
    valid: Boolean
    error_message: String? when valid = false
}

-- ============================================================================
-- Lint-pipeline entities
-- ============================================================================

entity LintScenarioResult {
    invocation: LintInvocation
    scenario: Scenario
    checks: List<LintedCheck>
    checks_total: Integer
    checks_with_issues: Integer
}

-- ============================================================================
-- Run command: lifecycle
-- ============================================================================

rule StartRun {
    when: RunInvoked(operator, evals_dir, raw_repeats?, raw_concurrency?,
                     raw_timeout?, scenario_filter?, agent_model?, grader_model?)
    let dir = eval_root_at(evals_dir)
    let effective_repeats =
        raw_repeats
        ?? dir.evals_config.repeats_override
        ?? config.default_repeats
    let effective_timeout =
        raw_timeout
        ?? dir.evals_config.timeout_override
    ensures: RunInvocation.created(
        operator: operator,
        eval_root: dir,
        repeats: effective_repeats,
        concurrency: raw_concurrency ?? config.default_concurrency,
        timeout: effective_timeout,
        scenario_filter: scenario_filter,
        agent_model_override: agent_model,
        grader_model_override: grader_model,
        status: starting
    )
    @guidance
        -- effective_timeout is null when neither the CLI flag nor
        -- evals.yaml sets a timeout; in that case scuttlerun's own
        -- default applies. When non-null, the value is materialised into
        -- the staged base config (see BeginRunStreaming guidance) so
        -- scuttlerun receives it via its top-level `timeout:` field.
}

rule BeginRunDiscovery {
    when: inv: RunInvocation.created
    requires: inv.status = starting
    ensures: inv.status = discovering
}

-- Garbage-collect prior artifact and staged-view tempdirs older than the
-- retention window. Best-effort: the current run's directories do not exist
-- yet at this point; per-directory failures are silently ignored. When
-- config.artifact_retention_days is 0 (or the evals.yaml override is 0),
-- cleanup is disabled.
rule CleanOldRunArtifacts {
    when: inv: RunInvocation.status transitions_to discovering
    let retention =
        inv.eval_root.evals_config.artifact_retention_days_override
        ?? config.artifact_retention_days
    requires: retention > 0
    ensures: clean_old_artifacts(
        prefixes: {config.artifact_prefix, config.staged_view_prefix},
        older_than: now - retention.days)
}

rule FailRunNoScenarios {
    when: inv: RunInvocation.status transitions_to discovering
    requires: inv.eval_root.scenarios.count = 0
    ensures: inv.status = failed
    ensures: inv.exit_code = 4
    ensures: emit_stderr("No scenarios found")
}

rule FailRunFilterEmpty {
    when: inv: RunInvocation.status transitions_to discovering
    requires: inv.scenario_filter != null
    requires: inv.eval_root.scenarios.count > 0
    requires: inv.selected_scenarios.count = 0
    ensures: inv.status = failed
    ensures: inv.exit_code = 4
    ensures: emit_stderr("No scenarios match filter")
}

-- Validation passed: create the artifact directory, stage a filtered view
-- of eval_root, and transition into streaming. The header is emitted on
-- the transition into streaming so it is never written for a run that
-- fails discovery.
rule BeginRunStreaming {
    when: inv: RunInvocation.status transitions_to discovering
    requires: inv.eval_root.scenarios.count > 0
    requires: inv.selected_scenarios.count > 0
    ensures: inv.artifact_dir =
        create_temp_dir(prefix: config.artifact_prefix)
    ensures: inv.staged_view = stage_eval_root(
        eval_root: inv.eval_root,
        scenarios_base: inv.eval_root.evals_config.scenarios_base,
        excluded_path: inv.eval_root.evals_config.scenarios_path,
        timeout_override: inv.timeout,
        prefix: config.staged_view_prefix)
    ensures: inv.status = streaming
    @guidance
        -- stage_eval_root creates <tmpdir>/<staged_view_prefix>X/<basename>/,
        -- symlinks every direct child of eval_root.path into it except
        -- evals_config.scenarios_path, and materialises evals_config.scenarios_base
        -- as <basename>/.craboodle-base.yaml. Scuttlerun is then invoked with
        -- (.craboodle-base.yaml, scenario.yaml), and its first-config-file's
        -- directory rule means the staged root becomes its working project
        -- root. Self-referential project.skills: [.] resolves to the staged
        -- root, whose basename is preserved from eval_root.path.
        --
        -- When inv.timeout is non-null it is overlaid as a top-level
        -- `timeout:` field on the materialised .craboodle-base.yaml,
        -- overriding any scenarios_base.timeout the user may have set.
        -- Scuttlerun reads it from there; craboodle never enforces the
        -- timeout itself (timeout handling is scuttlerun's domain).
}

rule StreamRunHeader {
    when: inv: RunInvocation.status transitions_to streaming
    ensures: emit_yaml_doc({ artifact_dir: inv.artifact_dir })
    ensures: emit_yaml_key("scenarios")
}

-- ============================================================================
-- Run command: building, executing and finalising work items
-- ============================================================================

rule BuildWorkItems {
    when: inv: RunInvocation.status transitions_to streaming
    for scenario in inv.selected_scenarios:
        for n in rep_numbers(1, inv.repeats):
            ensures: WorkItem.created(
                invocation: inv,
                scenario: scenario,
                rep_number: n,
                status: queued
            )
}

-- Dispatch decision for a newly queued WorkItem. The three outcomes are
-- mutually exclusive by construction (the conditional branches partition the
-- state space) so this rule replaces the natural-but-conflict-flagged trio
-- of ExecuteRep / AbortQueuedOnFailFast / SkipQueuedOnBudget.
rule DispatchWorkItem {
    when: item: WorkItem.created
    requires: item.status = queued
    ensures:
        if item.invocation.interrupt_requested:
            item.status = interrupted
        else if item.invocation.fail_fast_triggered:
            item.status = aborted
        else if item.invocation.budget_exceeded:
            item.status = budget_skipped
        else:
            item.status = running
    ensures:
        if item.invocation.interrupt_requested:
            item.failure_message = "Interrupted (SIGINT)"
        else if item.invocation.fail_fast_triggered:
            item.failure_message = "Aborted (fail-fast)"
        else if item.invocation.budget_exceeded:
            item.failure_message = "Budget exceeded"
    @guidance
        -- The "running" branch is what the impl calls "admitted to the pool":
        -- Stage A (scuttlerun) and Stage B (pincenez) each have their own
        -- semaphore sized at invocation.concurrency, so up to 2 * concurrency
        -- items can be in flight at once. The transcript is written to
        -- <artifact_dir>/<scenario.id>/rep-N/output.yaml and the grading to
        -- <artifact_dir>/<scenario.id>/rep-N/grading.yaml. In-flight reps
        -- whose invocation later trips fail-fast or budget still finish;
        -- only items still queued at dispatch time are aborted/skipped.
}

rule RepSucceeds {
    when: item: WorkItem.status transitions_to running
    requires: rep_succeeded(item)
    ensures: item.status = succeeded
    ensures: item.transcript_path = rep_transcript_path(item)
    ensures: item.agent_cost_usd = rep_agent_cost(item)
    ensures: item.grading_cost_usd = rep_grading_cost(item)
    ensures: item.grading = rep_grading(item)
}

rule RepFails {
    when: item: WorkItem.status transitions_to running
    requires: rep_failed(item)
    ensures: item.status = failed
    ensures: item.failure_stage = rep_failure_stage(item)
    ensures: item.failure_message = rep_failure_message(item)
    ensures: item.transcript_path = rep_transcript_path_if_any(item)
    ensures: item.agent_cost_usd = rep_agent_cost_if_any(item)
    @guidance
        -- transcript_path is populated when scuttlerun emitted any stdout
        -- before exiting, even on the failure path: craboodle writes that
        -- partial transcript to <rep_dir>/output.yaml so operators can
        -- inspect what the agent did before the failure. It is absent only
        -- when scuttlerun produced no output (e.g., immediate config-error
        -- exit) — in which case the YAML errors block omits the transcript
        -- field rather than referencing a missing file.
}

-- A running rep observes invocation.interrupt_requested (set when the
-- operator sends SIGINT). The subprocess is aborted via AbortSignal and
-- the item transitions to a terminal `interrupted` state. The bounded
-- cleanup window (impl: ~500ms) before the parent forces exit 130 lives
-- below the spec's level of abstraction.
rule InterruptRunningItem {
    when: item: WorkItem.invocation.interrupt_requested becomes true
    requires: item.status = running
    ensures: item.status = interrupted
    ensures: item.failure_message = "Interrupted (SIGINT)"
}

-- ============================================================================
-- Run command: per-scenario aggregation and streaming
-- ============================================================================

-- Chained trigger: once every WorkItem for a scenario reaches terminal,
-- emit ScenarioReady so AggregateScenario can fire exactly once per scenario.
rule EmitScenarioReady {
    when: item: WorkItem.is_terminal becomes true
    let scenario_items =
        item.invocation.work_items where scenario = item.scenario
    requires: scenario_items.all(w => w.is_terminal)
    ensures: ScenarioReady(scenario: item.scenario, invocation: item.invocation)
}

rule AggregateScenario {
    when: ScenarioReady(scenario, invocation)
    let scenario_items = invocation.work_items where scenario = scenario
    let successes = scenario_items where status = succeeded
    let with_transcript = scenario_items where transcript_path != null
    let non_successes = scenario_items where status in
        {failed, aborted, budget_skipped, interrupted}
    let crashed = scenario_items where status = failed

    ensures: ScenarioResult.created(
        invocation: invocation,
        scenario: scenario,
        successful_reps_count: successes.count,
        failed_reps_count: non_successes.count,
        checks: averaged_check_results(successes),
        pass_rate:
            if successes.count = 0: null
            else: mean_pass_rate(successes),
        error_rate:
            if (successes.count + crashed.count) = 0: 0
            else: crashed.count / (successes.count + crashed.count),
        agent_cost_usd: sum_decimals(with_transcript.agent_cost_usd),
        grading_cost_usd: sum_decimals(successes.grading_cost_usd),
        cost_usd:
            sum_decimals(with_transcript.agent_cost_usd)
            + sum_decimals(successes.grading_cost_usd),
        errors: collect_rep_errors(non_successes)
    )
    @guidance
        -- pass_rate is the mean of per-check pass_rates across successful
        -- reps. A per-check pass_rate is (count of successes where pass = true)
        -- / successes.count. Failed, aborted and budget-skipped reps appear
        -- under errors and never contribute to the averaging. Partial reps
        -- (scuttlerun succeeded, pincenez failed) contribute their agent
        -- cost to cost reporting but not their (absent) grading cost.
        --
        -- error_rate is the reliability companion to pass_rate: the fraction
        -- of reps that crashed (status = failed) among the reps that actually
        -- ran (successes + crashed). Aborted and budget-skipped reps never ran
        -- to completion and are excluded from both numerator and denominator,
        -- so a fail-fast cascade cannot inflate error_rate. It is the raw
        -- fraction the reliability gate compares against (see ExitRunReliability).
}

rule StreamScenarioBlock {
    when: result: ScenarioResult.created
    ensures: emit_yaml_array_item(
        key: result.scenario.id,
        body: scenario_block(result))
    @guidance
        -- Passing checks (pass_rate = 1.0) emit only check + pass_rate;
        -- failing checks include per-rep evidence and optional transcript
        -- paths. Failed reps appear under an errors array on the scenario, and
        -- error_rate is emitted only when greater than 0. Blocks arrive in
        -- completion order; ordering between scenarios is not specified.
}

-- ============================================================================
-- Run command: completion and exit codes
-- ============================================================================

rule CompleteRun {
    when: inv: RunInvocation.all_scenarios_done becomes true
    requires: inv.status = streaming
    ensures: inv.status = completed
}

rule StreamTotalCost {
    when: inv: RunInvocation.status transitions_to completed
    requires: inv.total_cost_usd > 0
    ensures: emit_yaml_doc({ total_cost_usd: round4(inv.total_cost_usd) })
}

rule ExitRunBudgetExceeded {
    when: inv: RunInvocation.status transitions_to completed
    requires: inv.budget_exceeded
    ensures: inv.exit_code = 5
    ensures: emit_stderr("Budget exceeded")
    @guidance
        -- Budget exhaustion takes precedence over the ratchet and
        -- has_any_success exits: the run was deliberately cut short, so
        -- the functional verdict is incomplete and CI should treat the
        -- run as budget-limited rather than infer pass/fail/ratchet from
        -- a truncated sample. Exit 5 mirrors scuttlerun's
        -- exhausted_budget code.
}

rule ExitRunNoSuccess {
    when: inv: RunInvocation.status transitions_to completed
    requires: not inv.budget_exceeded
    requires: not inv.has_any_success
    ensures: inv.exit_code = 4
}

rule ExitRunReliability {
    when: inv: RunInvocation.status transitions_to completed
    requires: not inv.budget_exceeded
    requires: inv.has_any_success
    requires: inv.error_gate_triggered
    ensures: inv.exit_code = 4
    ensures: emit_stderr("Reliability check failed")
    @guidance
        -- Fires when a gated scenario's error_rate exceeds max_error_rate
        -- (default 0 = any crash fails). Maps to exit 4 (infrastructure
        -- error) rather than 3 (ratchet), keeping a crash-driven failure
        -- distinguishable from a quality regression, and takes precedence
        -- over the ratchet so an infra failure is never reported as a quality
        -- one. Like the ratchet, it applies only when min_pass_rate has opted
        -- the suite into gating.
}

rule ExitRunRatchet {
    when: inv: RunInvocation.status transitions_to completed
    requires: not inv.budget_exceeded
    requires: inv.has_any_success
    requires: not inv.error_gate_triggered
    requires: inv.fail_fast_triggered
    ensures: inv.exit_code = 3
    ensures: emit_stderr("Threshold check failed")
}

rule ExitRunSuccess {
    when: inv: RunInvocation.status transitions_to completed
    requires: not inv.budget_exceeded
    requires: inv.has_any_success
    requires: not inv.error_gate_triggered
    requires: not inv.fail_fast_triggered
    ensures: inv.exit_code = 0
}

-- ============================================================================
-- List command
-- ============================================================================

rule StartList {
    when: ListInvoked(operator, evals_dir, scenario_filter?)
    let dir = eval_root_at(evals_dir)
    ensures: ListInvocation.created(
        operator: operator,
        eval_root: dir,
        scenario_filter: scenario_filter,
        status: starting
    )
}

rule BeginListDiscovery {
    when: inv: ListInvocation.created
    requires: inv.status = starting
    ensures: inv.status = discovering
}

rule FailListNoScenarios {
    when: inv: ListInvocation.status transitions_to discovering
    requires: inv.eval_root.scenarios.count = 0
    ensures: inv.status = failed
    ensures: inv.exit_code = 4
    ensures: emit_stderr("No scenarios found")
}

rule FailListFilterEmpty {
    when: inv: ListInvocation.status transitions_to discovering
    requires: inv.scenario_filter != null
    requires: inv.eval_root.scenarios.count > 0
    requires: inv.selected_scenarios.count = 0
    ensures: inv.status = failed
    ensures: inv.exit_code = 4
    ensures: emit_stderr("No scenarios match filter")
}

rule BeginListStreaming {
    when: inv: ListInvocation.status transitions_to discovering
    requires: inv.eval_root.scenarios.count > 0
    requires: inv.selected_scenarios.count > 0
    ensures: inv.staged_view = stage_eval_root(
        eval_root: inv.eval_root,
        scenarios_base: inv.eval_root.evals_config.scenarios_base,
        excluded_path: inv.eval_root.evals_config.scenarios_path,
        prefix: config.staged_view_prefix)
    ensures: inv.status = streaming
}

-- For each selected scenario: count its checks and validate the merged
-- scuttlerun config via dry_run. The base config materialised inside the
-- staged view is what scuttlerun dry-runs against; this matches the run
-- command's invocation shape so list and run agree on validity.
rule ListValidateAndEmit {
    when: inv: ListInvocation.status transitions_to streaming
    for scenario in inv.selected_scenarios:
        ensures: ListEntry.created(
            invocation: inv,
            scenario: scenario,
            check_count: scenario.checks_config.check_count,
            valid: scuttlerun_dry_run_valid(
                scenario_config: scenario.scenario_config,
                base_config_path: inv.staged_view.base_config_path),
            error_message: scuttlerun_dry_run_error(
                scenario_config: scenario.scenario_config,
                base_config_path: inv.staged_view.base_config_path)
        )
        ensures: emit_list_entry(scenario.id)
}

rule CompleteList {
    when: inv: ListInvocation.all_entries_done becomes true
    requires: inv.status = streaming
    ensures: inv.status = completed
}

rule ExitListInvalid {
    when: inv: ListInvocation.status transitions_to completed
    requires: inv.any_invalid
    ensures: inv.exit_code = 1
}

rule ExitListSuccess {
    when: inv: ListInvocation.status transitions_to completed
    requires: not inv.any_invalid
    ensures: inv.exit_code = 0
}

-- ============================================================================
-- Lint command
-- ============================================================================

rule StartLint {
    when: LintInvoked(operator, evals_dir, raw_concurrency?, scenario_filter?,
                      grader_model?)
    let dir = eval_root_at(evals_dir)
    ensures: LintInvocation.created(
        operator: operator,
        eval_root: dir,
        scenario_filter: scenario_filter,
        concurrency: raw_concurrency ?? config.default_concurrency,
        grader_model_override: grader_model,
        status: starting
    )
}

rule BeginLintDiscovery {
    when: inv: LintInvocation.created
    requires: inv.status = starting
    ensures: inv.status = discovering
}

rule FailLintNoScenarios {
    when: inv: LintInvocation.status transitions_to discovering
    requires: inv.eval_root.scenarios.count = 0
    ensures: inv.status = failed
    ensures: inv.exit_code = 4
    ensures: emit_stderr("No scenarios found")
}

rule FailLintFilterEmpty {
    when: inv: LintInvocation.status transitions_to discovering
    requires: inv.scenario_filter != null
    requires: inv.eval_root.scenarios.count > 0
    requires: inv.selected_scenarios.count = 0
    ensures: inv.status = failed
    ensures: inv.exit_code = 4
    ensures: emit_stderr("No scenarios match filter")
}

rule BeginLintStreaming {
    when: inv: LintInvocation.status transitions_to discovering
    requires: inv.eval_root.scenarios.count > 0
    requires: inv.selected_scenarios.count > 0
    ensures: inv.staged_view = stage_eval_root(
        eval_root: inv.eval_root,
        scenarios_base: inv.eval_root.evals_config.scenarios_base,
        excluded_path: inv.eval_root.evals_config.scenarios_path,
        prefix: config.staged_view_prefix)
    ensures: inv.status = streaming
}

-- Per-scenario lint invocations run concurrently up to invocation.concurrency.
-- Each scenario's effective config is first resolved via scuttlerun dry_run
-- (the same invocation shape as list and run, against the staged base), and
-- the resolved prompt and tool list ground pincenez lint: the prompt enables
-- tautology detection, the tool list grounds tool-availability judgments.
-- Invocations that fail are logged to stderr but do not create a result;
-- if no invocation succeeds, the run exits 4 (see ExitLintNoInvocations).
rule LintInvokePincenez {
    when: inv: LintInvocation.status transitions_to streaming
    for scenario in inv.selected_scenarios:
        let resolved = scuttlerun_resolved_config(
            scenario_config: scenario.scenario_config,
            base_config_path: inv.staged_view.base_config_path)
        ensures: LintScenarioResult.created(
            invocation: inv,
            scenario: scenario,
            checks: pincenez_lint_checks(
                checks_config: scenario.checks_config,
                context: resolved?.prompt,
                available_tools: resolved?.tools,
                grader_model_override: inv.grader_model_override),
            checks_total: pincenez_lint_total(scenario.checks_config),
            checks_with_issues: pincenez_lint_issue_count(scenario.checks_config)
        )
}

-- Grounding degradations are surfaced as per-scenario stderr warnings
-- rather than passing unnoticed. Exit code is unaffected; the warnings
-- are advisory. A failed resolution degrades all grounding (no context,
-- no tool list); a resolved config without a prompt degrades only
-- tautology detection.
rule WarnLintResolutionFailed {
    when: inv: LintInvocation.status transitions_to streaming
    for scenario in inv.selected_scenarios:
        requires: scuttlerun_resolved_config(
            scenario_config: scenario.scenario_config,
            base_config_path: inv.staged_view.base_config_path) = null
        ensures: emit_stderr("Could not resolve scenario config; lint grounding degraded")
}

rule WarnLintMissingPromptContext {
    when: inv: LintInvocation.status transitions_to streaming
    for scenario in inv.selected_scenarios:
        requires: scuttlerun_resolved_config(
            scenario_config: scenario.scenario_config,
            base_config_path: inv.staged_view.base_config_path) != null
        requires: scuttlerun_resolved_config(
            scenario_config: scenario.scenario_config,
            base_config_path: inv.staged_view.base_config_path).prompt = null
        ensures: emit_stderr("Scenario has no prompt; tautology detection degraded")
}

rule StreamLintScenario {
    when: result: LintScenarioResult.created
    requires: result.checks_with_issues > 0
    ensures: emit_yaml_array_item(
        key: result.scenario.id,
        body: lint_block(result))
    @guidance
        -- Per-scenario blocks are emitted only for scenarios with at least
        -- one issue; aggregate totals at the end always reflect every check
        -- that was linted.
}

rule CompleteLint {
    when: inv: LintInvocation.all_lint_invocations_done becomes true
    requires: inv.status = streaming
    ensures: inv.status = completed
}

rule ExitLintNoInvocations {
    when: inv: LintInvocation.status transitions_to completed
    requires: inv.lint_results.count = 0
    ensures: inv.exit_code = 4
}

rule ExitLintIssuesFound {
    when: inv: LintInvocation.status transitions_to completed
    requires: inv.lint_results.count > 0
    requires: inv.total_issues > 0
    ensures: inv.exit_code = 1
}

rule ExitLintClean {
    when: inv: LintInvocation.status transitions_to completed
    requires: inv.lint_results.count > 0
    requires: inv.total_issues = 0
    ensures: inv.exit_code = 0
}

-- ============================================================================
-- Init command (separate flow; no scenarios, no streaming output)
-- ============================================================================

rule StartInit {
    when: InitInvoked(operator, target_dir)
    ensures: InitInvocation.created(
        operator: operator,
        target_dir: target_dir,
        status: starting
    )
}

rule InitRefuseExistingEvals {
    when: init: InitInvocation.created
    requires: init.status = starting
    requires: file_exists(init.target_dir, "evals.yaml")
    ensures: init.status = refused
    ensures: init.refusal_reason = existing_evals_yaml
    ensures: init.exit_code = 1
    ensures: emit_stderr("already contains evals.yaml")
}

rule InitRefuseExistingScenarios {
    when: init: InitInvocation.created
    requires: init.status = starting
    requires: not file_exists(init.target_dir, "evals.yaml")
    requires: scenario_files_present(init.target_dir)
    ensures: init.status = refused
    ensures: init.refusal_reason = existing_scenario_files
    ensures: init.exit_code = 1
    ensures: emit_stderr("already contains scenario files")
}

-- The scaffold always writes evals.yaml at the target dir. Its body is
-- mode-flavoured: skill mode emits a `project.skills: ['.']`
-- self-reference hint; plugin mode emits a `project.plugins: ['.']`
-- self-reference hint that loads the plugin bundle cohesively (skills +
-- hooks + sub-agents + MCP servers + commands); generic mode emits a
-- placeholder. Detection is by filesystem probe.
--
-- In plugin mode the scaffold additionally fans out one informative
-- placeholder scenario per discovered component, under
-- evals/<scenario-id>/{scenario,checks}.yaml. The <scenario-id> is
-- `<type>-<id>-placeholder` for named components (where <type> is
-- `skill`, `agent`, or `command` and <id> is the component id, sorted)
-- and `<id>-placeholder` for singleton components (where <id> is the
-- literal `hooks` or `mcp-servers`). These prefixes match the coverage
-- diagnostic's named-component (`<type>-<id>` / `<type>-<id>-*`) and
-- singleton (`<type>` / `<type>-*`) patterns, so a freshly scaffolded
-- plugin reports full per-component coverage out of the box. Each placeholder carries a
-- TODO prompt and a commented example check keyed to the component
-- type's transcript observability surface (`tool: Skill`, `tool: Agent`,
-- a user-message slash-command prefix, an observable hook side effect,
-- or `tool: mcp__<server>__<tool>`). When the plugin has two or more
-- components, the scaffold also writes a single `composition-placeholder`
-- scenario: a TODO prompt directing the author to exercise two or more
-- components together in one session, plus a commented check skeleton
-- noting that a composition scenario must keep at least one
-- cross-component check (asserting two or more components interacting, not
-- one in isolation). It is omitted for single-component plugins, where a
-- composition scenario is meaningless. Skill mode and generic mode write
-- only evals.yaml.
rule InitCreateScaffold {
    when: init: InitInvocation.created
    requires: init.status = starting
    requires: not file_exists(init.target_dir, "evals.yaml")
    requires: not scenario_files_present(init.target_dir)
    ensures: write_scaffold(init.target_dir, "evals.yaml",
                            evals_template_for(init.target_dir))
    ensures: write_plugin_placeholders_if_plugin_mode(init.target_dir,
                                                     plugin_components_of(init.target_dir))
    ensures: init.status = created
    ensures: init.exit_code = 0
}

-- ============================================================================
-- evals.yaml validation (eager, at load time)
-- ============================================================================

rule RejectUnknownConfigKeys {
    when: cfg: EvalsConfig.created
    requires: evals_yaml_has_unknown_keys(cfg.eval_root.path)
    @guidance
        -- Load fails with exit 2; the rejecting invocation never reaches
        -- the state machine above. Recognised top-level keys are: version,
        -- min_pass_rate, max_error_rate, max_budget_usd, repeats,
        -- artifact_retention_days, timeout, scenarios. Inside scenarios: path,
        -- base. The base block itself is not validated by craboodle; that
        -- contract belongs to scuttlerun.
}

rule RejectUnsupportedVersion {
    when: cfg: EvalsConfig.created
    requires: cfg.version not in config.supported_config_versions
    @guidance
        -- Load fails with exit 2. Bumping the supported version set means
        -- widening config.supported_config_versions and updating the init
        -- template.
}

rule RejectInvalidMinPassRate {
    when: cfg: EvalsConfig.created
    requires: cfg.min_pass_rate != null
    requires: cfg.min_pass_rate < 0 or cfg.min_pass_rate > 1
    @guidance
        -- Load fails with exit 2. min_pass_rate must be in [0, 1].
}

rule RejectInvalidMaxErrorRate {
    when: cfg: EvalsConfig.created
    requires: cfg.max_error_rate != null
    requires: cfg.max_error_rate < 0 or cfg.max_error_rate > 1
    @guidance
        -- Load fails with exit 2. max_error_rate must be in [0, 1]. Setting
        -- max_error_rate without min_pass_rate loads successfully but is inert
        -- (the reliability gate only applies to gated suites); craboodle warns.
}

-- ============================================================================
-- Surfaces (one per command; the CLI is a shell-facing boundary)
-- ============================================================================

surface RunCommand {
    facing operator: Operator
    context invocation: RunInvocation where operator = operator

    provides:
        RunInvoked(operator, evals_dir, raw_repeats?, raw_concurrency?,
                   raw_timeout?, scenario_filter?, agent_model?, grader_model?)

    exposes:
        invocation.artifact_dir
        invocation.scenario_results
        invocation.total_cost_usd
        invocation.exit_code

    contracts:
        demands Scuttlerun
        demands Pincenez

    @guarantee StreamingOutput
        -- stdout is valid YAML after each per-scenario block is written.
        -- The header (artifact_dir + scenarios:) is emitted before any
        -- scenario block; blocks arrive in completion order; ordering
        -- between scenarios is not specified. Long single-line strings
        -- render in block-folded (`>`) style; multi-line strings render
        -- in block-literal (`|`) style. Lines exceeding 80 columns in
        -- the final output are wrapped — by the YAML serializer for
        -- block-folded scalars and by hard-wrapping at word boundaries
        -- for block-literal scalars. Strings without any whitespace
        -- break point are preserved verbatim even when longer than 80
        -- columns.

    @guarantee RawPassRates
        -- pass_rate and error_rate fields are fractional (0.0 .. 1.0) and are
        -- never collapsed to verdicts. The gates (min_pass_rate, max_error_rate)
        -- only affect the process exit code, never the reported numbers.

    @guarantee ArtifactsPreserved
        -- The artifact directory survives the run (success or failure)
        -- and its path appears in the output as artifact_dir. Cleanup of
        -- older directories happens at the start of the next run, not at
        -- the end of this one.

    @guarantee RunExitCodes
        -- 0 success; 3 ratchet failure; 4 no successful reps. See the
        -- shared exit code taxonomy at the top of this spec.
}

surface ListCommand {
    facing operator: Operator
    context invocation: ListInvocation where operator = operator

    provides:
        ListInvoked(operator, evals_dir, scenario_filter?)

    exposes:
        invocation.eval_root.evals_config.version
        invocation.eval_root.evals_config.min_pass_rate
        invocation.list_entries
        invocation.total_scenarios
        invocation.total_checks
        invocation.invalid_count
        invocation.exit_code

    contracts:
        demands Scuttlerun

    @guarantee ConfigValidation
        -- For each scenario, the merged scuttlerun config is validated by
        -- delegating to scuttlerun's dry-run mode. Invalid scenarios are
        -- reported with the validator's error message and the command
        -- exits with code 1.

    @guarantee ListBaseHeader
        -- Before the scenarios block, a `base:` header summarises the
        -- pipeline-level fields from evals.yaml. version is always present
        -- (required by the schema); min_pass_rate is included only when
        -- set. The header is emitted even when min_pass_rate is absent.

    @guarantee ListTotalsFooter
        -- After the scenarios block, a `total:` line summarises the
        -- number of scenarios and the sum of checks across them. When
        -- any scenario is invalid, an `invalid:` count follows and the
        -- command exits with code 1.

    @guarantee ListExitCodes
        -- 0 all scenarios valid; 1 at least one invalid scenario;
        -- 4 no scenarios or empty filter.
}

surface LintCommand {
    facing operator: Operator
    context invocation: LintInvocation where operator = operator

    provides:
        LintInvoked(operator, evals_dir, raw_concurrency?, scenario_filter?,
                    grader_model?)

    exposes:
        invocation.lint_results
        invocation.scenarios_total
        invocation.scenarios_with_issues
        invocation.checks_total
        invocation.checks_with_issues
        invocation.exit_code

    contracts:
        demands PincenezLint

    @guarantee ScenarioPromptAsContext
        -- The scenario's prompt is read from scenario.yaml and passed to
        -- pincenez lint as context so the linter can flag checks that are
        -- tautological given the prompt.

    @guarantee IssuesGateExitCode
        -- Exit 0 only if zero issues were found across all linted checks;
        -- exit 1 otherwise. Per-scenario blocks are emitted only for
        -- scenarios with at least one issue; aggregate totals always
        -- reflect every check.

    @guarantee LintTotalsFooter
        -- After the per-scenario blocks, two summary mappings are emitted:
        -- first {scenarios_total, scenarios_with_issues}, then
        -- {checks_total, checks_with_issues}. Both reflect every linted
        -- scenario and check, including those without issues that were
        -- omitted from the per-scenario blocks.

    @guarantee LintExitCodes
        -- 0 clean; 1 issues found; 4 no scenarios, empty filter, or zero
        -- lint invocations succeeded.
}

surface InitCommand {
    facing operator: Operator
    context invocation: InitInvocation where operator = operator

    provides:
        InitInvoked(operator, target_dir)

    exposes:
        invocation.exit_code

    @guarantee RefusesOverwrite
        -- If the target already contains evals.yaml or any scenario
        -- directory matching <scenarios_path>/<id>/scenario.{yaml,yml},
        -- init refuses with exit code 1 and writes nothing.

    @guarantee InitSuccessMessage
        -- On successful scaffold, init writes a confirmation block to
        -- stdout naming the created directory and the files written, then
        -- a "Next steps:" block listing the suggested follow-up commands
        -- (scenario authoring, list, lint, run). When a composition
        -- placeholder was scaffolded, the Next steps block additionally
        -- points the author at it. The exact wording is incidental UX, but
        -- the two blocks are part of the contract.
}

-- ============================================================================
-- Contracts (external-tool boundaries)
-- ============================================================================

contract Scuttlerun {
    run: (scenario_config: ScuttlerunConfig,
          base_config: ScuttlerunConfig,
          agent_model_override: String) -> Transcript

    dry_run: (scenario_config: ScuttlerunConfig,
              base_config: ScuttlerunConfig) -> ResolvedSessionConfig?

    @guidance
        -- dry_run validates the merged config and, on success, yields the
        -- resolved (post-merge) session summary scuttlerun prints; null
        -- means validation failed. The list command consumes only
        -- success/failure; the lint command additionally consumes the
        -- resolved prompt and tool list to ground pincenez lint.

    @invariant TranscriptIsRaw
        -- craboodle treats the transcript as opaque and never extracts
        -- or transforms it. It is handed straight to pincenez as the
        -- grading subject.

    @invariant ConfigMergeIsScuttlerunsConcern
        -- craboodle materialises scenarios.base from evals.yaml as
        -- .craboodle-base.yaml inside the staged view, then passes both
        -- files (.craboodle-base.yaml, scenario.yaml) to scuttlerun and
        -- relies on scuttlerun's native deep merge. craboodle never reads,
        -- merges or transforms scenario.yaml; its only handling of
        -- scenarios.base is to emit it verbatim into the staged file.
}

contract Pincenez {
    grade: (checks_config: ChecksConfig,
            transcript: Transcript,
            grader_model_override: String) -> Grading
}

contract PincenezLint {
    lint: (checks_config: ChecksConfig,
           context: String?,
           available_tools: List<String>?,
           grader_model_override: String) -> List<LintedCheck>

    @guidance
        -- context is the scenario's resolved prompt; available_tools is the
        -- resolved (post-merge) tool list. Both are omitted when scuttlerun
        -- resolution fails — pincenez then lints with degraded grounding
        -- (no tautology detection, no availability judgments).
}

-- ============================================================================
-- Invariants
-- ============================================================================

invariant PassRateNullIffNoSuccesses {
    for result in ScenarioResults:
        (result.pass_rate = null) = (result.successful_reps_count = 0)
}

invariant WorkItemCountMatchesRepeats {
    -- For every settled scenario, the rep counts cover every dispatched
    -- WorkItem exactly once. Failed, aborted and budget-skipped reps all
    -- appear in failed_reps_count; only succeeded reps appear in
    -- successful_reps_count.
    for result in ScenarioResults:
        result.successful_reps_count + result.failed_reps_count
            = result.invocation.repeats
}

invariant CostFieldsAreNonNegative {
    for result in ScenarioResults:
        result.cost_usd >= 0
        and result.agent_cost_usd >= 0
        and result.grading_cost_usd >= 0
}

invariant ArtifactDirCarriesPrefix {
    for inv in RunInvocations:
        inv.status in {starting, discovering, failed}
        or inv.artifact_dir.starts_with(config.artifact_prefix)
}

invariant RatchetOnlyWhenConfigured {
    for inv in RunInvocations:
        inv.status = completed and inv.exit_code = 3
        implies
        inv.eval_root.evals_config.min_pass_rate != null
}

-- Generic mode (neither SKILL.md nor .claude-plugin/plugin.json present at
-- the eval root) has no portable self-referential skill path. Relative
-- paths inside scenarios.base.project.skills only resolve under skill or
-- plugin mode; generic-mode suites must use absolute or ~-prefixed paths.
invariant GenericModeForbidsRelativeSkills {
    for root in EvalRoots:
        root.mode in {skill, plugin}
        or scenarios_base_skill_paths_are_anchored(root.evals_config.scenarios_base)
}

invariant StagedViewExistsWhenStreaming {
    for inv in RunInvocations:
        inv.status in {starting, discovering, failed}
        or inv.staged_view != null
}

invariant StagedViewExcludesScenariosPath {
    for inv in RunInvocations:
        inv.staged_view = null
        or inv.staged_view.excluded_path
            = inv.eval_root.evals_config.scenarios_path
}

-- ============================================================================
-- Open questions
-- ============================================================================

-- (no open questions)
